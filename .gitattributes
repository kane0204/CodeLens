# 统一行尾：仓库内一律使用 LF，避免 Windows 提交的 CRLF 破坏 shell 脚本与 CI
* text=auto eol=lf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.docx binary
*.xlsx binary
*.zip binary

# 显式声明需要 LF 的脚本
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# 语言标注，便于 GitHub 统计与高亮
*.py linguist-language=Python
*.ts linguist-language=TypeScript
