    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.1.0"
  }
